{
  "name": "pocket-teach",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Pocket Teach — an offline-first PWA + generation gateway for LLM-authored learning lessons, built on the /teach methodology.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosmoreira/pocket-teach.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter api dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "start": "pnpm --filter api start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yaml,yml,html,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  }
}
