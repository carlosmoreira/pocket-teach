# Pocket Teach backend — copy to `.env` and adjust.

# Port the server binds (container maps this through docker-compose).
PORT=8787

# Single static bearer token guarding every route except /health.
# The private network (intranet + Tailscale) is the real boundary; rotate freely.
GATEWAY_TOKEN=dev-token

# Active LLM provider. v1 ships only "claude".
PROVIDER=claude

# The single model the Teacher's agentic loop runs on. Env-switchable to a
# premium model (e.g. an Opus tier) or, later, a local model.
MODEL=claude-sonnet-5

# Required for real generation/chat. The server boots without it, but any
# generate/chat call returns a clear "not set" error.
ANTHROPIC_API_KEY=
