# Pocket Teach gateway — copy to `.env` and adjust.

# Port the Fastify server binds (container maps this through docker-compose).
PORT=8787

# Single static bearer token guarding every route except /health.
# The network (intranet + Tailscale/WireGuard) is the real boundary; rotate freely.
GATEWAY_TOKEN=dev-token

# Active LLM provider. v1 ships only "claude".
PROVIDER=claude

# Planner + writer models. Writer is env-switchable to a premium model (e.g. opus).
PLANNER_MODEL=claude-sonnet-5
WRITER_MODEL=claude-sonnet-5

# Optional in chunk 1 (logic is stubbed). Required once chunk 2 wires the AI SDK.
ANTHROPIC_API_KEY=
